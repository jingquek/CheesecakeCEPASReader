<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f5f5f5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CEPAS Purse 3 CAN Scanner"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Scan Button -->
        <Button
            android:id="@+id/btnScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scan CEPAS Purse 3"
            android:textSize="16sp"
            android:background="@drawable/button_primary"
            android:textColor="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="24dp" />

        <!-- Status -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready to scan CEPAS Purse 3"
            android:textSize="14sp"
            android:textColor="#666666"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="24dp"
            android:elevation="2dp" />

        <!-- NFC Commands -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NFC Commands Sent to Retrieve Purse 3"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvNfcCommands"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No commands sent yet"
            android:textSize="12sp"
            android:textColor="#666666"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="24dp"
            android:elevation="2dp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp" />

        <!-- Purse Information -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CEPAS Purse 3 Information"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvPurseInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No purse data"
            android:textSize="12sp"
            android:textColor="#666666"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="24dp"
            android:elevation="2dp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp" />

        <!-- CAN Bytes -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CAN Bytes (8-15)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvCANBytes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No data"
            android:textSize="14sp"
            android:textColor="#666666"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="24dp"
            android:elevation="2dp"
            android:fontFamily="monospace" />

        <!-- Card Serial -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Card Serial (64-bit)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvCardSerial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No data"
            android:textSize="16sp"
            android:textColor="#2196F3"
            android:textStyle="bold"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="24dp"
            android:elevation="2dp"
            android:fontFamily="monospace" />

        <!-- Calculation Details -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CAN ID Calculation Details"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvCalculation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No calculation data"
            android:textSize="12sp"
            android:textColor="#666666"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="24dp"
            android:elevation="2dp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>
</ScrollView>
